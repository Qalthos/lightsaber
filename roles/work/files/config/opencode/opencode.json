{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "google-vertex-anthropic/claude-opus-4-6@default",
  "small_model": "google-vertex-anthropic/claude-haiku-4-5@default",
  "agent": {
    "build": {
      "color": "warning",
      "model": "google-vertex-anthropic/claude-sonnet-4-6@default"
    },
    "plan": {
      "model": "google-vertex-anthropic/claude-opus-4-6@default"
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "sonarqube": {
      "type": "remote",
      "url": "https://api.sonarcloud.io/mcp",
      "headers": {
        "Authorization": "Bearer {env:SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "automation-nexus"
      }
    }
  }
}
